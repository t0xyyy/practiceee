digraph ER {
  graph [fontname="DejaVu Sans",bgcolor="white",rankdir=LR,pad=.4,nodesep=.65,ranksep=1.1,splines=polyline];
  node [shape=plain,fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans",color="#448475",fontcolor="#347468",penwidth=2,fontsize=11,arrowsize=.7];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#cddfd4"><TR><TD BGCOLOR="#136c5c" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id : INTEGER</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">login : TEXT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">email : TEXT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">password_hash, full_name, phone</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">role, created_at</TD></TR></TABLE>>];
  courses [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#cddfd4"><TR><TD BGCOLOR="#136c5c" COLSPAN="2"><FONT COLOR="white"><B>courses</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id : INTEGER</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">code : TEXT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">title, category, summary</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">duration, level, price, color, icon</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD></TR></TABLE>>];
  applications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#cddfd4"><TR><TD BGCOLOR="#dff1e7" COLSPAN="2"><FONT COLOR="#12463a"><B>applications</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id : INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id → users.id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">course_id → courses.id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">start_date, payment_method</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status, created_at, updated_at</TD></TR></TABLE>>];
  reviews [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#cddfd4"><TR><TD BGCOLOR="#f8e4c4" COLSPAN="2"><FONT COLOR="#65461b"><B>reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id : INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>FK + UQ</B></TD><TD ALIGN="LEFT">application_id → applications.id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id → users.id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rating, text, created_at</TD></TR></TABLE>>];
  sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#cddfd4"><TR><TD BGCOLOR="#e6e5f6" COLSPAN="2"><FONT COLOR="#343165"><B>sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id : TEXT (hash)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id → users.id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">expires_at : INTEGER</TD></TR></TABLE>>];
  history [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#cddfd4"><TR><TD BGCOLOR="#e4edf9" COLSPAN="2"><FONT COLOR="#334a6e"><B>status_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id : INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">application_id → applications.id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">admin_id → users.id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">old_status, new_status, changed_at</TD></TR></TABLE>>];
  users -> applications [label="1 → N", color="#267966"];
  courses -> applications [label="1 → N", color="#267966"];
  users -> sessions [label="1 → N"];
  applications -> reviews [label="1 → 0..1"];
  users -> reviews [label="1 → N"];
  applications -> history [label="1 → N"];
  users -> history [label="администратор 1 → N"];
}
